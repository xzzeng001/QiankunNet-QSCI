figure


hf=-106.47984262283;
ccsd=-106.98760909682;
shci=-107.3603963752;
fci=-107.43844013207;


nn1=length(y1);
x1=1:nn1;
nn2=length(y2);
x2=1:nn2;
nn3=length(y3);
x3=1:nn3;
nn4=length(y4);
x4=1:nn4;
nn=30000;

yy1=y1;
yy2=y2;
yy3=y3;
yy4=y4;
%yy1=smooth(y1);
%yy2=smooth(y2);
%yy3=smooth(y3);
%yy4=smooth(y4);

subplot(1,2,1)
h1=plot(x1,yy1,'-','linewidth',6,'Markersize',12);
col1=get(h1,'color');

hold on
h2=plot(x2,yy2,'-','linewidth',6,'Markersize',12);
col2=get(h2,'color');

h3=plot(x3,yy3,'-','linewidth',6,'Markersize',12);
col3=get(h3,'color');

h4=plot(x4,yy4,'-','linewidth',6,'Markersize',12);
col4=get(h4,'color');


h5=plot([1 nn],[hf hf],'--','linewidth',4,'Markersize',12);
col5=get(h5,'color');
h6=plot([1 nn],[ccsd ccsd],'--','linewidth',4,'Markersize',12);
col6=get(h6,'color');
h7=plot([1 nn],[shci shci],'--','linewidth',4,'Markersize',12);
col7=get(h7,'color');
h8=plot([1 nn],[fci fci],'--','linewidth',4,'Markersize',12);
col8=get(h8,'color');

legend('QiankunNet','QiankunNet+LUCJ','QiankunNet+SHCI','QiankunNet+USCI-SHCI','HF','CCSD','SHCI','FCI')
legend('boxoff')

set(gca,'fontsize',20)
set(gca,'linewidth',2)

xlabel('Iteration','interpreter','latex')
ylabel('Energy (Ha)','interpreter','latex')


subplot(1,2,2)
x_sq = [1,30000,30000,1];   % 逆时针遍历每个点的x值
y_sq = [1e-5,1e-5,1.6e-3,1.6e-3];   % 逆时针遍历每个点的y值
fill(x_sq,y_sq,'p');   % 填充函数
hold on

h9=plot(x1,yy1-fci,'-','Color',col1,'linewidth',6,'Markersize',12);

hold on
h10=plot(x2,yy2-fci,'-','Color',col2,'linewidth',6,'Markersize',12);
h11=plot(x3,yy3-fci,'-','Color',col3,'linewidth',6,'Markersize',12);
h12=plot(x4,yy4-fci,'-','Color',col4,'linewidth',6,'Markersize',12);

h13=plot([1 nn],[hf-fci hf-fci],'--','Color',col5,'linewidth',4,'Markersize',12);
h14=plot([1 nn],[ccsd-fci ccsd-fci],'--','Color',col6,'linewidth',4,'Markersize',12);
h15=plot([1 nn],[shci-fci shci-fci],'--','Color',col7,'linewidth',4,'Markersize',12);

set(gca,'fontsize',20)
set(gca,'linewidth',2)

xlabel('Iteration','interpreter','latex')
ylabel('Absolute energy error (Ha)','interpreter','latex')
